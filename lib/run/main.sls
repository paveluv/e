;; One generic head pump. Trusted startup scripts own composition and policy.
(import (only (foundation edoc) elibrary))
(elibrary (run main)
  (export run!)
  (import (chezscheme)
    (prefix (core client) client:) (prefix (core kernel) kernel:) (prefix (core startup) startup:)
    (prefix (head head) head:) (prefix (head interaction) interaction:) (prefix (head root) root:)
    (prefix (head suspension) suspension:) (prefix (head tui) tui:) (prefix (head widget) widget:)
    (prefix (service log) log:) (prefix (state actor) actor:))

  (define (resume-commands!)
    (suspension:drain! (lambda (ex) (log:add! 'main:resume-commands! (kernel:condition-text ex)))))
  (define (run-command! thunk)
    (suspension:call! head:ui-actor (lambda () (head:run-on-main! resume-commands!)) thunk))
  (define (current-root)
    (let ([binding (root:current)]) (and binding (cdr (assq 'root (cdr (assq 'value binding)))))))
  (define (deliver-file! path)
    (let ([root (current-root)])
      (if (and root (assq 'open-file (widget:commands root))) (widget:invoke! root 'open-file path)
        (head:report! (format "This composition does not accept file requests: ~a" path)))))
  (define (quit!)
    (let ([root (current-root)])
      (if (and root (assq 'quit (widget:commands root))) (widget:invoke! root 'quit) (head:quit!))))

  (edoc "Run the selected startup composition and the single head event pump. The installed start.e is the default; alternative scripts need no editor or windows."
    (returns integer "exit status") (public))
  (define (run!)
    (kernel:pin-modules! '("main"))
    (parameterize ([exit-handler (exit-handler)] [abort-handler (abort-handler)] [reset-handler (reset-handler)])
      (actor:call-as head:ui-actor run-head)))
  (define (run-head)
    (kernel:load-module! "root")
    (let-values ([(status binding)
                  (root:start! (or (startup:start-file) (string-append (kernel:installation-directory) "/start.e"))
                    (if (startup:file) (list (startup:file)) '()) '((backend . tui)))])
      (unless (eq? status 'applied) (error 'run-head "startup root was not admitted" status)))
    (keyboard-interrupt-handler void)
    ;; Scheme exit/abort follows the composition's explicit departure command,
    ;; then unwinds this evaluation instead of bypassing terminal cleanup.
    (let ([safe-quit (lambda args (quit!) (raise (head:make-interrupted)))])
      (exit-handler safe-quit) (abort-handler safe-quit) (reset-handler safe-quit))
    (dynamic-wind
      (lambda () (tui:enter!) (head:start-input-reader!))
      (lambda ()
        (head:run-deferred!)
        (let ([file (startup:file)]) (when file (run-command! (lambda () (deliver-file! file)))))
        (let loop ()
          (unless (head:quitting?)
            (resume-commands!) (head:run-deferred!) (head:redraw! #t)
            (guard (ex [(client:ended? ex) (raise ex)]
                       [(kernel:read-only-error? ex) (head:report! "Buffer is read-only")]
                       [(kernel:refusal? ex) (head:report! (condition-message ex))]
                       [else (log:add! 'main:run-head (kernel:condition-text ex))])
              (let ([event (parameterize ([head:in-main-pump #t]) (head:read-key-event))])
                (run-command! (lambda () (head:key! event)))))
            (head:after-key!) (loop))))
      (lambda ()
        (suspension:close! head:ui-actor)
        (dynamic-wind void head:run-shutdown-hooks!
          (lambda ()
            (guard (ex [else (void)]) (interaction:flush!))
            (tui:leave!))))))
)
